{
  "name": "proxysuite",
  "private": true,
  "version": "2.0.0",
  "description": "High-performance, security-hardened HTTP/HTTPS diagnostic proxy and authorized security testing platform.",
  "author": {
    "name": "pprpprppr",
    "email": "108631308+pprpprppr@users.noreply.github.com"
  },
  "homepage": "https://github.com/pprpprppr/PROXY_ENGINE",
  "license": "MIT",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "start:prod": "NODE_ENV=production node dist-server/server.js",
    "build": "vite build && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').copyFileSync('server/db/sqliteWorker.mjs', 'dist-server/server/db/sqliteWorker.mjs')\"",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "electron:dev": "npm run build:server && electron .",
    "electron:build": "npm run build && electron-builder --publish never",
    "electron:build:linux": "npm run build && electron-builder --linux deb AppImage tar.gz --publish never",
    "electron:build:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "com.proxysuite.desktop",
    "productName": "ProxySuite",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "pprpprppr <108631308+pprpprppr@users.noreply.github.com>"
    },
    "deb": {
      "packageCategory": "devel",
      "priority": "optional"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "assets/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-mitm-proxy": "^1.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.5"
  }
}
