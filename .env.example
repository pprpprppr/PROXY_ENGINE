# ProxySuite Environment Configuration

# Required for AI Analysis features. Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required for WebSocket connections and self-referencing if on a public URL.
# Locally, defaults to http://localhost:3000
APP_URL=http://localhost:3000

# Port configuration (Optional)
# PORT=3000
# PROXY_PORT=8082
