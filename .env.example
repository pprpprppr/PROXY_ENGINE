# ProxySuite Environment Configuration

# Required ONLY for optional user-triggered AI Security Analysis (backend-only)
# Get an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini API model (default: gemini-2.5-flash)
# Supported: gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite, gemini-2.0-flash, gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Network bindings (defaults strictly to loopback for security)
HOST=127.0.0.1
PORT=3000
PROXY_HOST=127.0.0.1
PROXY_PORT=8082

# Data storage directory for SQLite DB and MITM Root CA (defaults to cwd or Electron userData)
# PROXYSUITE_DATA_DIR=./data

# Memory & capture limits (bytes)
# MAX_REQ_BODY_CAPTURE_BYTES=1048576
# MAX_RES_BODY_CAPTURE_BYTES=2097152
# MAX_INTERCEPT_BODY_BYTES=5242880
# MAX_ACTIVE_REQUESTS=500

# Diagnostic TLS override (keep false in normal use)
# ALLOW_INSECURE_TLS=false
